[
    {
        "type": "text",
        "label": "Better Zen Gradient Picker",
        "margin": "30px 0 30px 0",
        "size": "20px"
    },
    {
        "type": "separator",
        "label": "Optional Features",
        "margin": "15px 0 15px 0"
    },
    {
        "type": "checkbox",
        "property": "zen.theme.separate-color-schemes",
        "label": "Separate Light / Dark Gradients",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Save a separate gradient for each workspace in light and dark mode. Edit each mode to customize it. Follows Zen appearance (and your system when set to Auto). Temporarily overrides Dynamic Theme and Lightness Inversion. Disabled by default.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    },
    {
        "type": "checkbox",
        "property": "zen.theme.independent-color-points",
        "label": "Independent Color Points",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Move each color point freely without moving the others. Overrides color harmonies while enabled. Adding or removing points keeps the remaining colors in place. Brightness, opacity and texture controls still apply to the whole gradient.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    },
    {
        "type": "checkbox",
        "property": "zen.theme.active-tab-color.enabled",
        "label": "Custom Active Tab Color",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Choose the active sidebar tab color independently of the gradient. Use the color picker in the gradient editor or enter HEX colors below. Text contrast adjusts automatically. Applies across workspaces.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    },
    {
        "type": "string",
        "property": "zen.theme.active-tab-color.light",
        "label": "Active Tab \u2014 Light",
        "defaultValue": "#8b5cf6",
        "placeholder": "#8b5cf6",
        "border": "value",
        "conditions": [
            {
                "if": {
                    "property": "zen.theme.active-tab-color.enabled",
                    "value": true
                }
            }
        ]
    },
    {
        "type": "string",
        "property": "zen.theme.active-tab-color.dark",
        "label": "Active Tab \u2014 Dark",
        "defaultValue": "#a78bfa",
        "placeholder": "#a78bfa",
        "border": "value",
        "conditions": [
            {
                "if": {
                    "property": "zen.theme.active-tab-color.enabled",
                    "value": true
                }
            }
        ]
    },
    {
        "type": "checkbox",
        "property": "zen.theme.dynamic-theme-switching",
        "label": "Dynamic Theme",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Automatically switch between light and dark mode based on gradient lightness. Requires Zen light/dark mode set to auto.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    },
    {
        "type": "checkbox",
        "property": "zen.theme.text-lock",
        "label": "Text Color Lock",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Keep sidebar and toolbar text tied to the browser light/dark mode instead of the gradient brightness.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    },
    {
        "type": "checkbox",
        "property": "zen.theme.lightness-inversion",
        "label": "Lightness Inversion (Experimental)",
        "margin": "12px 0 4px 0"
    },
    {
        "type": "text",
        "label": "Invert gradient lightness to match the active browser theme, for example darker gradients in dark mode.",
        "margin": "0 0 12px 24px",
        "size": "12px"
    }
]
